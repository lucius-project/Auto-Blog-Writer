# Copy to .env and fill in. NEVER commit real secrets.

# --- Infrastructure (ports chosen to avoid other 911it stacks on this box) ---
DATABASE_URL=postgresql://abw:abw@localhost:55433/abw
REDIS_URL=redis://localhost:63790

# --- App ---
API_PORT=3101
WEB_ORIGIN=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:3101

# --- AI (OpenRouter, OpenAI-compatible API) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# default model; individual pipeline stages may override
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# --- DataForSEO (SERP + AI Overviews + LLM Mentions + keyword demand; Basic auth) ---
# Gap analysis MUST use live endpoints, never cached results.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Publishing (per-tenant targets live in DB; these are dev defaults) ---
WORDPRESS_BASE_URL=
WORDPRESS_APP_PASSWORD=

# encryption key for stored publish-target credentials (generate: openssl rand -hex 24)
ABW_SECRET_KEY=
